  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p verify",
    "verify:data": "tsx verify/data.ts",
    "verify:library": "tsx verify/library.ts",
    "verify:migration": "tsx verify/migration.ts",
    "verify": "npm run verify:data && npm run verify:library && npm run verify:migration",
    "build:apk": "bash scripts/build-apk.sh",
    "assets:modelos": "${BLENDER:-blender} --background --factory-startup --python scripts/exportar_latas.py -- ../Monster",
    "assets:etiquetas": "../Monster/.venv/bin/python scripts/preparar_etiquetas.py ../Monster",
    "assets:botellas": "${BLENDER:-blender} --background --factory-startup --python scripts/exportar_botellas.py -- ../Monster"
  },
